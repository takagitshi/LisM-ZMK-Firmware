#define ZMK_POINTING_DEFAULT_SCRL_VAL 200

#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    tapping-term-ms = <300>;
    flavor = "balanced";
};

&lt {
    tapping-term-ms = <300>;
    quick-tap-ms = <300>;
};

/*
 * Keep the standard &inc_dec_kp interface so Keymap Editor can edit both keycodes.
 * Its clockwise/counter-clockwise children add the shared two-step filter.
 */
&inc_dec_kp {
    bindings = <&encoder_key_divider_cw>, <&encoder_key_divider_ccw>;
};

/ {
    macros {
        emoji: emoji_macro {
            compatible = "zmk,behavior-macro";
            label = "EMOJI";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp CAPSLOCK>,
                <&macro_tap>,
                <&kp E>,
                <&macro_release>,
                <&kp CAPSLOCK>;
        };
    };

    behaviors {
        encoder_key_divider_cw: encoder_key_divider_cw {
            compatible = "zmk,behavior-encoder-key-divider";
            #binding-cells = <1>;
            bindings = <&kp>;
            divisor = <2>;
            timeout-ms = <300>;
            direction = <1>;
            display-name = "Encoder Two-Step Clockwise";
        };

        encoder_key_divider_ccw: encoder_key_divider_ccw {
            compatible = "zmk,behavior-encoder-key-divider";
            #binding-cells = <1>;
            bindings = <&kp>;
            divisor = <2>;
            timeout-ms = <300>;
            direction = <2>;
            display-name = "Encoder Two-Step Counter-Clockwise";
        };

        encoder_msc: sensor_rotate_msc {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;

            tap-ms = <20>;
        };

        encoder_none: sensor_rotate_none {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&none>, <&none>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp Q             &kp W         &kp E             &kp R  &kp T                                                    &kp Y             &kp U    &kp I            &kp O      &kp P
&kp A             &kp S         &kp D             &kp F  &kp G                                                    &kp H             &kp J    &kp K            &kt L      &lt 2 MINUS
&mt LSHIFT Z      &kp X         &kp C             &kp V  &kp B                                                    &lt 4 N           &lt 3 M  &kp COMMA        &kp DOT    &mt RSHIFT QUESTION
&kp LEFT_COMMAND  &kp LEFT_ALT  &kp LEFT_CONTROL  &none  &mt LEFT_CONTROL LANGUAGE_2  &lt 5 SPACE    &lt 6 ENTER  &lt 2 LANGUAGE_1  &none    &lt 7 SEMICOLON  &kp LA(Y)  &lt 8 TILDE
                                &none             &none  &none                                                    &none             &none    &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        layer_1 {
            display-name = "Mouse";
            bindings = <
&trans            &trans  &trans  &trans  &trans                    &trans  &trans    &trans    &trans    &trans
&trans            &trans  &trans  &trans  &trans                    &trans  &mkp MB1  &mkp MB3  &mkp MB2  &trans
&kp LSHIFT        &trans  &trans  &trans  &trans                    &trans  &trans    &trans    &trans    &trans
&kp LEFT_COMMAND  &kp LEFT_ALT  &kp LEFT_CONTROL  &none   &kp LEFT_CONTROL  &trans    &trans  &trans  &none     &trans    &trans    &trans
                          &none   &none   &none                     &none   &none     &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        layer_2 {
            display-name = "Scroll";
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans    &kp UP    &trans     &kp LG(BACKSPACE)
&trans  &trans  &trans  &trans  &trans                    &trans  &kp LEFT  &kp DOWN  &kp RIGHT  &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &trans    &trans    &trans     &trans
&trans  &trans  &trans  &none   &trans  &trans    &trans  &trans  &none     &trans    &trans     &trans
                &none   &none   &none                     &none   &none     &none
            >;

            sensor-bindings = <&encoder_none>;
        };

        layer_3 {
            display-name = "Gesture";
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans          &kp LC(UP_ARROW)     &trans           &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &kp LC(LEFT_ARROW)  &trans              &kp LC(RIGHT_ARROW)  &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &trans          &kp LC(DOWN_ARROW)   &trans           &trans
&trans  &trans  &trans  &none   &trans  &trans    &trans  &trans  &none   &trans  &trans  &trans
                &none   &none   &none                     &none   &none   &none
            >;

            sensor-bindings = <&encoder_none>;
        };

        layer_4 {
            display-name = "symbol";
            bindings = <
&kp EXCLAMATION  &kp AT_SIGN     &kp HASH        &kp DOLLAR  &kp PERCENT                    &kp CARET  &kp AMPERSAND  &kp ASTERISK  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS
&kp LG(LS(N3))   &kp LG(LS(N4))  &kp LG(LS(N5))  &kp LA(A)   &kp LG(LA(S))                  &kp MINUS  &kp EQUAL      &kp SLASH     &kp LEFT_BRACKET      &kp RIGHT_BRACKET
&trans           &trans          &trans          &trans      &trans                         &trans     &trans         &kp SEMICOLON  &kp SQT               &kp GRAVE
&trans  &trans  &trans  &none   &trans  &trans    &trans  &trans  &none   &trans  &trans  &trans
                &none   &none   &none                     &none   &none   &none
            >;

            sensor-bindings = <&encoder_none>;
        };

        layer_5 {
            display-name = "number";
            bindings = <
&kp F1   &kp F2   &kp F3   &kp F4   &kp F5                     &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp PLUS      &kp MINUS
&kp F6   &kp F7   &kp F8   &kp F9   &kp F10                    &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp ASTERISK  &kp SLASH
&kp F11  &kp F12  &trans   &trans   &trans                     &kp NUMBER_0  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp COMMA
&trans   &trans   &trans   &none    &trans   &trans    &trans  &kp PERIOD    &none         &kp COLON     &kp EQUAL     &kp LA(Y)
                 &none    &none    &none                       &none         &none         &none
            >;

            sensor-bindings = <&encoder_none>;
        };

        layer_6 {
            display-name = "move";
            bindings = <
&kp ESCAPE  &trans  &trans  &trans  &trans                     &kp LG(T)  &kp LG(LS(N))     &kp LG(LA(P))     &kp LG(LS(H))  &kp LG(Q)
&kp TAB     &trans  &trans  &trans  &trans                     &kp HOME   &msc MOVE_Y(-20)  &kp LG(C)         &kp LG(V)      &kp LG(W)
&trans      &trans  &trans  &trans  &trans                     &kp END    &msc MOVE_Y(20)   &kp F18           &kp LA(LC(F))  &kp LG(R)
&trans      &trans  &trans  &trans  &kp DEL  &trans    &trans  &trans     &trans            &kp LC(LA(LEFT))  &kp LC(DOWN)   &kp LC(LA(RIGHT))
                    &trans  &trans  &trans                     &trans     &trans            &trans
            >;

            sensor-bindings = <&encoder_msc SCRL_UP SCRL_DOWN>;
        };

        layer_7 {
            display-name = "setting";
            bindings = <
&none       &none           &none   &none   &bt BT_CLR                            &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&none       &none           &none   &none   &none                                 &none         &none         &none         &none         &none
&sys_reset  &none           &none   &none   &none                                 &none         &none         &none         &none         &sys_reset
&none       &bt BT_CLR_ALL  &none   &kp LG(NUMBER_0)  &bootloader  &none    &studio_unlock  &bootloader   &none         &none         &none         &none
                            &trans  &trans  &trans                                      &trans        &trans        &trans
            >;

            sensor-bindings = <&inc_dec_kp LG(PLUS) LG(MINUS)>;
        };

        layer_8 {
            display-name = "User 8";
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &none   &trans  &trans    &trans  &trans  &none   &trans  &trans  &trans
                &none   &none   &none                     &none   &none   &none
            >;

            sensor-bindings = <&encoder_none>;
        };
    };
};
